# Copy this file to .env and fill in real values for local development.
# .env is gitignored -- never commit real credentials.
#
# This configures the PERSISTENT APPLICATION database (PostgreSQL) added
# in Phase 4.1. It has nothing to do with the cricket statistics dataset
# (data/cricket.duckdb), which needs no configuration and is not
# affected by any of this -- see cricket-stats-game/DATABASE.md.

# Standard libpq connection URL: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://cricket_app:CHANGE_ME@127.0.0.1:5432/cricket_app

# Phase 4.2 (authentication): signs the Flask session cookie -- both the
# game's own state and who's logged in. Generate a real one with:
#   py -c "import secrets; print(secrets.token_hex(32))"
# If left unset, extensions.py auto-generates and persists one to a
# gitignored .flask_secret_key file instead, so a fresh checkout still
# runs with zero setup -- but that fallback is for casual local dev
# only. Set this explicitly for anything else.
FLASK_SECRET_KEY=CHANGE_ME

# Leave false for local HTTP dev -- a Secure cookie is silently dropped
# by the browser over plain HTTP. Set true in any real HTTPS deployment.
SESSION_COOKIE_SECURE=false
